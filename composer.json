{
  "name": "seatlayer/seatlayer-php",
  "description": "Official PHP server SDK for the SeatLayer reserved-seating API.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://docs.seatlayer.io/server-sdk/install/",
  "keywords": ["seatlayer", "reserved-seating", "seating-chart", "ticketing", "box-office"],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-hash": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.11"
  },
  "autoload": {
    "psr-4": { "SeatLayer\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "SeatLayer\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "validate:all": ["@analyse", "@test"]
  },
  "config": {
    "sort-packages": true
  }
}
